# Copy to .env and fill in ONE provider's key. Never commit .env.
DEFAULT_MODEL=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKEN=2000

# CPU works without an NVIDIA GPU. Use cuda only with compatible drivers.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./models/cache
# First use needs network access to download the model.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=150
CHROMA_DB_PATH=./data/chroma_db
SEARCH_TOP_K=3
ENABLE_SEARCH_CACHE=false
SEARCH_CACHE_TTL=300
SEARCH_CACHE_MAX_SIZE=100

# Leave empty for the bundled same-origin UI.
# For a separate UI, list explicit origins separated by commas.
CORS_ORIGINS=
